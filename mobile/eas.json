{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.unidal.pt",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://apontamento.unidal.pt"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.unidal.pt",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://apontamento.unidal.pt"
      }
    }
  }
}
